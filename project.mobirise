    "index.html": {
      "settings": {
        "main": true,
        "title": "#1 Balayage Highlights St. George Utah - Hair Extensions Near Me, Platinum Blonde, Ombré, Color Correction",
        "meta_descr": "Balayage Highlights St. George is Southern Utah's #1 Luxury Hair Salon Focused Exclusively on Balayage, Highlights, Platinum Blonde, Ombre, Hair Extensions, & \"Fix My Hair\" Color Correction.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
